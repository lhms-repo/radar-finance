# Topology of the agent bridge: which machine executes and how this planner machine reaches it.
# Copy to topology.env on the planner machine, fill it in and run: chmod 600 topology.env
# Install: setup.sh apply topology.env [--test] [--lock-password]
# Remove:  setup.sh remove topology.env
# Values are read literally: no $VAR expansion and no comments after a value.

# Executor machine, reached over SSH. It needs openssh-server and the updated repository.
EXECUTOR_HOST=
EXECUTOR_SSH_USER=
EXECUTOR_SSH_PORT=22
# Absolute path of the project on the executor machine.
EXECUTOR_REPO_DIR=

# Planner machine (the one running apply and remove).
# Key created and authorized on the executor when missing.
EXECUTOR_SSH_KEY=~/.ssh/radar_executor
# Where the bridge scripts and the planner .env live. Default: the folder of setup.sh.
PLANNER_DIR=
PLANNER_MOUNT_DIR=~/radar-remote
PLANNER_MOUNT_READONLY=1

# Agent settings written to the executor .env. Empty keeps what the executor setup detected.
# read-only or workspace-write.
AGENT_SANDBOX=
AGENT_MODEL=
AGENT_HOME_DIR=
