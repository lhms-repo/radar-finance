# Copy to .env next to the scripts, fill it in and run: chmod 600 .env
# The scripts refuse a .env that is not mode 600 or not owned by the current user.
# Values are read literally: no $VAR expansion and no comments after a value.
# Leave a line empty to use its default. Never commit the .env.

# Planner machine (planner.sh)
# Executor machine host name or reserved IP on the local network.
EXECUTOR_HOST=
EXECUTOR_SSH_USER=
EXECUTOR_SSH_PORT=22
# Private key for task, reply and check. It may be restricted to executor.sh in authorized_keys.
EXECUTOR_SSH_KEY=~/.ssh/radar_executor
# Optional second key for run and mount. Default: EXECUTOR_SSH_KEY.
EXECUTOR_SSH_TOOLS_KEY=
# Absolute path of the project on the executor machine.
EXECUTOR_REPO_DIR=
# Default: $EXECUTOR_REPO_DIR/tools/agent-bridge/executor.sh
EXECUTOR_SCRIPT=
PLANNER_MOUNT_DIR=~/radar-remote
# 1 mounts read-only, so only the executor writes to the project.
PLANNER_MOUNT_READONLY=1

# Executor machine (executor.sh)
# Default: the repository that contains this folder.
REPO_DIR=
# Absolute path of the agent binary (default: codex) when it is not on the PATH of non-interactive SSH sessions.
AGENT_BIN=
# Extra PATH entries, separated by colons, for go, pnpm, node and the agent.
AGENT_PATH_EXTRA=
# read-only or workspace-write. Default: workspace-write.
AGENT_SANDBOX=
# Model for every task. Default: the model in the agent configuration.
AGENT_MODEL=
# Optional separate agent home, exported as CODEX_HOME (config, login and session history). Default: ~/.codex
AGENT_HOME_DIR=
