# Copy to .env next to the scripts, fill it in and run: chmod 600 .env
# The scripts refuse a .env that is not mode 600 or not owned by the current user.
# Values are read literally: no $VAR expansion and no comments after a value.
# Leave a line empty to use its default. Never commit the .env.

# Claude machine (claude-bridge.sh)
# Codex machine host name or reserved IP on the local network.
CODEX_HOST=
CODEX_SSH_USER=
CODEX_SSH_PORT=22
# Private key for task, reply and check. It may be restricted to codex-server.sh in authorized_keys.
CODEX_SSH_KEY=~/.ssh/radar_codex
# Optional second key for run and mount. Default: CODEX_SSH_KEY.
CODEX_SSH_TOOLS_KEY=
# Absolute path of the project on the Codex machine.
CODEX_REMOTE_REPO=
# Default: $CODEX_REMOTE_REPO/tools/codex-bridge/codex-server.sh
CODEX_REMOTE_SERVER=
CLAUDE_MOUNT_DIR=~/radar-codex
# 1 mounts read-only, so only Codex writes to the project.
CLAUDE_MOUNT_READONLY=1

# Codex machine (codex-server.sh)
# Default: the repository that contains this folder.
CODEX_REPO_DIR=
# Absolute path of the codex binary when it is not on the PATH of non-interactive SSH sessions.
CODEX_BIN=
# Extra PATH entries, separated by colons, for go, pnpm, node and codex.
CODEX_PATH_EXTRA=
# read-only or workspace-write. Default: workspace-write.
CODEX_SANDBOX=
# Model for every task. Default: the model in the Codex configuration.
CODEX_MODEL=
# Optional separate Codex home (config, login and session history). Default: ~/.codex
CODEX_HOME_DIR=
