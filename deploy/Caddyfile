# HTTPS on the local network with the mkcert certificate (RNF-21).
{
	auto_https disable_certs
	admin off
	# Browsers send no server name when opening an IP address; use the single local certificate.
	default_sni {$RADAR_DEFAULT_SNI}
}

{$RADAR_HOSTS} {
	tls /certs/radar.pem /certs/radar-key.pem
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy radar:8080
}
