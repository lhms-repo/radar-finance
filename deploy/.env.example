# Copie para deploy/.env e ajuste. O arquivo .env não vai para o repositório.

# Endereços do servidor, separados por vírgula: nome da máquina e IP reservado no roteador (RNF-22).
RADAR_HOSTS=meupc.local, 192.168.0.10

# Pasta do Windows que recebe os backups, vista de dentro do WSL2 (RNF-05).
RADAR_BACKUP_HOST_DIR=/mnt/c/RadarBackups

# Hora local do backup diário e quantidade de cópias mantidas.
RADAR_BACKUP_HOUR=3
RADAR_BACKUP_KEEP=30

# Tempo de inatividade até a sessão expirar (RNF-10). Exemplos: 12h, 168h, 720h.
RADAR_SESSION_IDLE=168h
